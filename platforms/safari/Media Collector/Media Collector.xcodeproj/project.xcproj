  "targets": [
    {
      "name": "Media Collector",
      "id": "A75F24C130B5C1F100162FC0",
      "product": "Products/Media Collector.app",
      "product-type": "application",
      "dependencies": [
        "Media Collector Extension",
      ],
      "build-phases": [
        "compile-sources",
        "frameworks",
        "resources",
        {
          "kind": "copy",
          "name": "Embed Foundation Extensions",
          "bundle-base-path": "plugins-directory",
        },
      ],
      "build-settings": {
        "ASSETCATALOG_COMPILER_APPICON_NAME": "AppIcon",
        "ASSETCATALOG_COMPILER_GLOBAL_ACCENT_COLOR_NAME": "AccentColor",
        "CODE_SIGN_STYLE": "Automatic",
        "COMBINE_HIDPI_IMAGES": "YES",
        "CURRENT_PROJECT_VERSION": "1",
        "ENABLE_APP_SANDBOX": "YES",
        "ENABLE_HARDENED_RUNTIME": "YES",
        "ENABLE_OUTGOING_NETWORK_CONNECTIONS": "YES",
        "ENABLE_USER_SELECTED_FILES": "readonly",
        "GENERATE_INFOPLIST_FILE": "YES",
        "INFOPLIST_FILE": "Media Collector/Info.plist",
        "INFOPLIST_KEY_CFBundleDisplayName": "Media Collector",
        "INFOPLIST_KEY_NSHumanReadableCopyright": "",
        "INFOPLIST_KEY_NSMainStoryboardFile": "Main",
        "INFOPLIST_KEY_NSPrincipalClass": "NSApplication",
        "INFOPLIST_KEY_NSViewGestureRecognizerIsExclusive": "NO",
        "LD_RUNPATH_SEARCH_PATHS": [
          "$(inherited)",
          "@executable_path/../Frameworks",
        ],
        "MARKETING_VERSION": "5.3.0",
        "OTHER_LDFLAGS": [
          "-framework",
          "SafariServices",
          "-framework",
          "WebKit",
        ],
        "PRODUCT_BUNDLE_IDENTIFIER": "com.dougscodesontheloose.mediacollector",
        "PRODUCT_NAME": "$(TARGET_NAME)",
        "REGISTER_APP_GROUPS": "YES",
        "STRING_CATALOG_GENERATE_SYMBOLS": "YES",
        "SWIFT_APPROACHABLE_CONCURRENCY": "YES",
        "SWIFT_DEFAULT_ACTOR_ISOLATION": "MainActor",
        "SWIFT_EMIT_LOC_STRINGS": "YES",
        "SWIFT_UPCOMING_FEATURE_MEMBER_IMPORT_VISIBILITY": "YES",
        "SWIFT_VERSION": "5.0",
      },
    }, {
      "name": "Media Collector Extension",
      "id": "A75F24DC30B5C1F200162FC0",
      "product": "Products/Media Collector Extension.appex",
      "product-type": "app-extension",
      "build-phases": [
        "compile-sources",
