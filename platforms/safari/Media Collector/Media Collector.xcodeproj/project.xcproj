        "ENABLE_HARDENED_RUNTIME": "YES",
        "ENABLE_OUTGOING_NETWORK_CONNECTIONS": "YES",
        "ENABLE_USER_SELECTED_FILES": "readwrite",
        "GENERATE_INFOPLIST_FILE": "YES",
        "INFOPLIST_FILE": "Media Collector Extension/Info.plist",
        "INFOPLIST_KEY_CFBundleDisplayName": "Media Collector Extension",
        "INFOPLIST_KEY_NSHumanReadableCopyright": "",
        "LD_RUNPATH_SEARCH_PATHS": [
          "$(inherited)",
          "@executable_path/../Frameworks",
          "@executable_path/../../../../Frameworks",
        ],
        "MACOSX_DEPLOYMENT_TARGET": "13.3",
        "MARKETING_VERSION": "5.3.0",
        "OTHER_LDFLAGS": [
          "-framework",
          "SafariServices",
        ],
        "PRODUCT_BUNDLE_IDENTIFIER": "com.dougscodesontheloose.mediacollector.Extension",
        "PRODUCT_NAME": "$(TARGET_NAME)",
        "SKIP_INSTALL": "YES",
        "STRING_CATALOG_GENERATE_SYMBOLS": "YES",
        "SWIFT_APPROACHABLE_CONCURRENCY": "YES",
        "SWIFT_EMIT_LOC_STRINGS": "YES",
        "SWIFT_UPCOMING_FEATURE_MEMBER_IMPORT_VISIBILITY": "YES",
